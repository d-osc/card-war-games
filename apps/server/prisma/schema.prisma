generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = "file:./dev.db"
}

model User {
  id        Int           @id @default(autoincrement())
  googleId  String?       @unique
  email     String?
  name      String
  avatar    String?
  isAdmin   Boolean       @default(false)
  createdAt DateTime      @default(now())
  character Character?
  instances CardInstance[]
}

model Character {
  id           Int      @id @default(autoincrement())
  userId       Int      @unique
  user         User     @relation(fields: [userId], references: [id])
  name         String
  level        Int      @default(1)
  xp           Int      @default(0)
  statPoints   Int      @default(0)
  allocated    String   @default("{}")
  gold         Int      @default(600)
  energy       Int      @default(100)
  energyAt     DateTime @default(now())
  mana         Int      @default(-1) // -1 = ยังไม่เคยซิงก์ → ถือว่าเต็ม
  stam         Int      @default(-1)
  hp           Int      @default(-1)
  regenAt      DateTime @default(now()) // จุดเริ่มนับการฟื้น hp/มานา/กำลังนอกสนาม (1/ชม.)
  rating       Int      @default(1000)
  wins         Int      @default(0)
  losses       Int      @default(0)
  highestFloor Int      @default(0)
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
}

model CardTemplate {
  id          String         @id
  name        String
  emoji       String
  category    String
  groupName   String
  rarity      String
  basePrice   Int
  description String
  data        String
  minted      Int            @default(0)
  burned      Int            @default(0)
  instances   CardInstance[]
}

model CardInstance {
  id         Int          @id @default(autoincrement())
  templateId String
  template   CardTemplate @relation(fields: [templateId], references: [id])
  ownerId    Int?
  owner      User?        @relation(fields: [ownerId], references: [id])
  status     String       @default("INVENTORY")
  slot       String?
  durability Int?         // ความทนทานเครื่องมือ (null = ไม่ใช่เครื่องมือ; เครื่องมือเก่าที่ยัง null ถือว่าเต็ม)
  createdAt  DateTime     @default(now())
}

model ShopListing {
  id         Int      @id @default(autoincrement())
  instanceId Int      @unique
  templateId String
  price      Int
  sellerName String
  status     String   @default("ACTIVE")
  createdAt  DateTime @default(now())
}

model Ledger {
  id         Int      @id @default(autoincrement())
  type       String
  userId     Int?
  templateId String?
  serial     Int?
  gold       Int?
  meta       String?
  createdAt  DateTime @default(now())
}

model HourlyQuest {
  id            Int       @id @default(autoincrement())
  userId        Int
  type          String
  target        Int
  progress      Int       @default(0)
  rewardGold    Int
  rewardXp      Int
  rewardCard    String?
  status        String    @default("ACTIVE")
  cooldownUntil DateTime?
  createdAt     DateTime  @default(now())
}

model PvpBattle {
  id          Int      @id @default(autoincrement())
  aId         Int
  bId         Int
  winnerId    Int?
  ratingDelta Int?
  endedAt     DateTime @default(now())
}

// ----------------------------------------------------------- เฟส 2: ตลาดการ์ด

model Auction {
  id               Int       @id @default(autoincrement())
  instanceId       Int       @unique
  templateId       String
  sellerId         Int
  sellerName       String
  startPrice       Int
  buyoutPrice      Int?
  currentBid       Int?
  currentBidderId  Int?
  currentBidderName String?
  status           String    @default("ACTIVE") // ACTIVE | SOLD | ENDED | CANCELLED
  endsAt           DateTime
  createdAt        DateTime  @default(now())
}

model DirectSale {
  id           Int      @id @default(autoincrement())
  instanceId   Int      @unique
  templateId   String
  sellerId     Int
  sellerName   String
  targetUserId Int
  targetName   String
  price        Int
  status       String   @default("ACTIVE") // ACTIVE | SOLD | CANCELLED
  expiresAt    DateTime
  createdAt    DateTime @default(now())
}

// ----------------------------------------------------------- เฟส 2: โซเชียล

model Friendship {
  id          Int      @id @default(autoincrement())
  requesterId Int
  addresseeId Int
  status      String   @default("PENDING") // PENDING | ACCEPTED
  createdAt   DateTime @default(now())

  @@unique([requesterId, addresseeId])
}

model Message {
  id         Int       @id @default(autoincrement())
  senderId   Int
  receiverId Int
  text       String
  readAt     DateTime?
  createdAt  DateTime  @default(now())
}

model Guild {
  id          Int      @id @default(autoincrement())
  name        String   @unique
  emblem      String
  description String   @default("")
  leaderId    Int
  createdAt   DateTime @default(now())
  members     GuildMember[]
  messages    GuildMessage[]
}

model GuildMember {
  id       Int      @id @default(autoincrement())
  guildId  Int
  guild    Guild    @relation(fields: [guildId], references: [id])
  userId   Int
  userName String
  role     String   @default("member") // leader | member
  joinedAt DateTime @default(now())

  @@unique([guildId, userId])
}

model GuildMessage {
  id         Int      @id @default(autoincrement())
  guildId    Int
  guild      Guild    @relation(fields: [guildId], references: [id])
  senderId   Int
  senderName String
  text       String
  createdAt  DateTime @default(now())
}

// ------------------------------------------------- เฟส 2: เควสต์ที่ผู้เล่นสร้าง

model PlayerQuest {
  id           Int      @id @default(autoincrement())
  creatorId    Int
  creatorName  String
  templateId   String   // การ์ดที่ต้องการ
  quantity     Int      // จำนวนที่ต้องการ
  delivered    Int      @default(0)
  goldPerUnit  Int      // รางวัลทองต่อใบ
  xpPerUnit    Int      @default(0) // รางวัล XP ต่อใบ (ผู้ตั้งจ่ายค่าเป็นทองตอนตั้งเควสต์)
  escrowGold   Int      // เงินฝากรวมคงเหลือ
  feePaid      Int
  status       String   @default("OPEN") // OPEN | DONE | CANCELLED
  createdAt    DateTime @default(now())
}
